# Copy this file to .env for local backend development.
# Never commit .env or put real secrets in frontend JavaScript.

# Supabase server-side configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY

# Resend email delivery (server-side only)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="SmartPick Hub <hello@your-verified-domain.com>"

# Public deployment URLs (HTTPS origins; FRONTEND_URL may include a site path)
PUBLIC_API_URL=https://YOUR_BACKEND_HOST
FRONTEND_URL=https://YOUR_FRONTEND_HOST

# SmartPick AI (OpenAI-compatible chat completions endpoint; server-side only)
# Set these in the backend host environment, never in frontend JavaScript.
LLM_API_KEY=YOUR_LLM_PROVIDER_API_KEY
LLM_BASE_URL=https://YOUR_PROVIDER/v1/chat/completions
LLM_MODEL=YOUR_CHAT_MODEL
